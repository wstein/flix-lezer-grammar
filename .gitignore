node_modules/
dist/

# flix-spec, fetched at the commit in spec.pin.json by `npm run fetch-spec`. Never committed:
# flix-spec owns those files and a copy here could only ever be a stale one.
.spec/

# Upstream Flix checkout used by `npm run corpus`; fetched, never committed.
.corpus/

# Declarations for the virtual modules the lezer Rollup plugin creates, written by
# scripts/build-grammar.mjs so `tsc` can resolve them. Generated, never committed.
src/flix.grammar.d.ts
src/flix.grammar.terms.d.ts

*.tsbuildinfo
.DS_Store
