  "notes": {
    "JavaQName": "Java-qualified names are parsed by a separate rule because their segment set differs, but the reference builds the same QName node for both.",
    "KindArrow": "The reference has no separate node for a kind arrow; both spellings close as Kind.",
    "ExprHoleNamed": "`?name` and `???` are one TreeKind upstream, distinguished by their token.",
    "\u26a0": "Lezer's single error node. The reference has three recovery kinds, so this is measured in the recovery lane only \u2014 see docs/CONFORMANCE.md.",
    "EnumBody": "The reference has no node for the braces around a group of declarations or rules; the children sit directly under the declaration. Same for the other entries in `flatten`.",
    "ExprQName": "A name in expression position is a bare QName upstream, with no expression node of its own.",
    "TypeName": "A type name is the same QName node the reference builds elsewhere; there is no Type.Name.",
    "RecordOp": "The reference splits this three ways -- RecordOpExtend, RecordOpRestrict, RecordOpUpdate -- by the leading `+`, `-` or none. This grammar has one rule with three alternatives, so the map can only name one of them; splitting the rule is the fix.",
    "ExprInvokeSuper": "The reference splits super invocation into InvokeSuperConstructor and InvokeSuperMethod. Same shape of problem as RecordOp.",
    "PredicateAndArity": "Declared at TreeKind top level, so it has no sub-trait prefix -- unlike every other Predicate.* kind."
  },
  "flatten": [
    "EnumBody",
    "TraitBody",
    "InstanceBody",
    "EffectBody",
    "MatchRuleList",
    "ExtMatchRuleList",
    "HandlerRuleList",
    "ForFragmentList",
    "ParYieldFragmentList"
  ],
  "ignored": ["ExprQName", "KindArrow"]
